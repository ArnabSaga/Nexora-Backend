ests/unit/modules/mention/mention-notification.test.ts tests/unit/modules/mention/mention-response.test.ts tests/unit/modules/mention/mention.validation.test.ts",
    "test:integration": "tsx tests/runners/integration.runner.ts tests/integration",
    "test:reaction:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/reaction",
    "test:vote:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/vote",
    "test:follow:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/follow",
    "test:community:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/community",
    "test:community-member:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/community-member",
    "test:community-rule:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/community-rule",
    "test:bookmark:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/bookmark",
    "test:notification:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/notification",
    "test:report:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/report",
    "test:hashtag:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/hashtag",
    "test:mention:integration": "tsx tests/runners/integration.runner.ts tests/integration/modules/mention",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio"
  },
  "keywords": [
    "social-media",
    "social-network",
    "social",
    "network",
    "media",
    "chat",
    "image-sharing",
    "video-sharing"
  ],
  "author": "ArnabSaga",
  "license": "ISC",
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "better-auth": "^1.6.12",
    "cloudinary": "^2.10.0",
    "cookie-parse": "^0.4.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "eslint": "^10.4.1",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.4.3"
  },
