model CommunityReport {
  id          String       @id @default(cuid())
  reporterId  String
  communityId String
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter  User      @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@index([reporterId])
  @@index([communityId])
  @@index([status])
  @@index([createdAt])
  @@map("community_report")
}
