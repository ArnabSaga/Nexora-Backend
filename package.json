{
  "name": "nexora-backend",
  "version": "1.0.0",
  "description": "Social media platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --clean",
