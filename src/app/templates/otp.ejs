<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'Security Verification' %> | <%= locals.appName || 'Nexora' %></title>
</head>
<body style="margin:0;padding:0;background:#f8f9fa;color:#191c1d;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8f9fa;margin:0;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border:1px solid #e1e3e4;border-radius:12px;overflow:hidden;">
          <tr>
            <td align="center" style="padding:28px 24px;border-bottom:1px solid #e1e3e4;">
              <div style="font-size:30px;line-height:36px;font-weight:800;color:#3525cd;">
                <%= locals.appName || 'Nexora' %>
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding:32px 24px;text-align:center;">
              <h1 style="margin:0 0 12px;font-size:24px;line-height:32px;color:#191c1d;">
                <%= locals.title || 'Verify your identity' %>
              </h1>

              <p style="margin:0 auto 24px;max-width:440px;font-size:16px;line-height:24px;color:#545f73;">
                <%= locals.message || 'Use this secure email to continue your Nexora authentication request.' %>
              </p>

              <% if (locals.code) { %>
                <div style="display:inline-block;margin:4px 0 24px;padding:18px 24px;background:#e2dfff;border:1px solid #c3c0ff;border-radius:12px;">
                  <div style="font-size:32px;line-height:40px;font-weight:800;letter-spacing:8px;color:#0f0069;">
                    <%= locals.code %>
                  </div>
                </div>
              <% } %>

              <% if (locals.actionUrl) { %>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:4px auto 24px;">
                  <tr>
                    <td bgcolor="#3525cd" style="border-radius:8px;">
                      <a href="<%= locals.actionUrl %>" style="display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:14px;line-height:20px;font-weight:700;">
                        <%= locals.actionLabel || 'Continue' %>
                      </a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 auto 20px;max-width:480px;font-size:13px;line-height:20px;color:#545f73;word-break:break-word;">
                  If the button does not work, copy and paste this link into your browser:<br>
                  <a href="<%= locals.actionUrl %>" style="color:#3525cd;text-decoration:underline;"><%= locals.actionUrl %></a>
                </p>
              <% } %>

              <div style="margin:24px auto 0;padding:16px;background:#fff4f2;border:1px solid #ffdad6;border-radius:8px;text-align:left;max-width:480px;">
                <p style="margin:0;font-size:14px;line-height:20px;color:#93000a;font-weight:700;">
                  Security reminder
                </p>
                <p style="margin:6px 0 0;font-size:14px;line-height:20px;color:#464555;">
                  This request expires in <%= locals.expiryMinutes || 10 %> minutes. Do not share this email or code with anyone. <%= locals.appName || 'Nexora' %> employees will never ask for your password or verification code.
                </p>
              </div>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:24px;background:#f3f4f5;border-top:1px solid #e1e3e4;">
              <p style="margin:0 0 8px;font-size:13px;line-height:20px;color:#545f73;">
                If you did not request this, you can safely ignore this email.
              </p>
              <p style="margin:0;font-size:12px;line-height:18px;color:#777587;">
                &copy; <%= new Date().getFullYear() %> <%= locals.appName || 'Nexora' %>. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
