  details      String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User    @relation("CommentReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("CommentReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([reporterId, commentId, status])
  @@index([commentId])
  @@index([status, createdAt, id])
  @@index([reason, createdAt, id])
  @@map("comment_report")
}

model CommunityReport {
  id           String       @id @default(cuid())
  reporterId   String
  communityId  String
  reason       ReportReason
  details      String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User      @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  community  Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([reporterId, communityId, status])
  @@index([communityId])
  @@index([status, createdAt, id])
  @@index([reason, createdAt, id])
  @@map("community_report")
}
