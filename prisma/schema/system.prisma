model Notification {
  id          String           @id @default(cuid())
  receiverId  String
  senderId    String?
  postId      String?
  commentId   String?
  communityId String?
  type        NotificationType
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  receiver  User       @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender    User?      @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  post      Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment   Comment?   @relation(fields: [commentId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([receiverId])
  @@index([senderId])
  @@index([postId])
  @@index([commentId])
  @@index([communityId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification")
}

model UserReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser User @relation("UserReportTarget", fields: [reportedUserId], references: [id], onDelete: Restrict)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
  @@map("user_report")
}

model PostReport {
  id         String       @id @default(cuid())
  reporterId String
  postId     String
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User @relation("PostReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  post     Post @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@index([reporterId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
  @@map("post_report")
}

model CommentReport {
  id         String       @id @default(cuid())
  reporterId String
